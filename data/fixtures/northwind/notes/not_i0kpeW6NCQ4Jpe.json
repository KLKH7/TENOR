    {
      "speaker": {
        "source": "speaker",
        "name": "Marcus Chen"
      },
      "text": "We honour it.",
      "start_time": "2026-09-29T13:12:52.040000Z",
      "end_time": "2026-09-29T13:12:53.040000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Marcus Chen"
      },
      "text": "Look, when I looked at the hiring plan for Northwind Teams, we're doing it two different ways.",
