      "end_time": "2026-09-29T13:14:18.801000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "And the thing like I'd push on is the feedback",
      "start_time": "2026-09-29T13:14:18.832000Z",
      "end_time": "2026-09-29T13:14:22.165000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Elena Petrova"
      },
      "text": "Yes.",
