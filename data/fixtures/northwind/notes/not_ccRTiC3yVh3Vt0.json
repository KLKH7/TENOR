      "end_time": "2026-09-15T14:06:27.458000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "so it's on people's radar.",
      "start_time": "2026-09-15T14:06:28.396000Z",
      "end_time": "2026-09-15T14:06:30.063000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Does the logging format actually matter for the payments migration?",
