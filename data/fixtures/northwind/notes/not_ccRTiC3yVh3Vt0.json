      "end_time": "2026-09-15T14:05:10.162000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Right",
      "start_time": "2026-09-15T14:05:10.180000Z",
      "end_time": "2026-09-15T14:05:10.780000Z"
    },
    {
      "speaker": {
