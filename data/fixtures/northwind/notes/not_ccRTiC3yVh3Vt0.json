      "end_time": "2026-09-15T14:06:09.046000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Alex Kim"
      },
      "text": "Hmm.",
      "start_time": "2026-09-15T14:06:05.354000Z",
      "end_time": "2026-09-15T14:06:05.954000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Real quick",
      "start_time": "2026-09-15T14:06:10.053000Z",
      "end_time": "2026-09-15T14:06:10.719000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "we should probably do it properly before we touch the dead letter queue.",
