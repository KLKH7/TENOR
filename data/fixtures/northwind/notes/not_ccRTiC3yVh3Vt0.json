    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Tomás Herrera"
      },
      "text": "Yeah, agreed",
      "start_time": "2026-09-15T14:06:18.758000Z",
      "end_time": "2026-09-15T14:06:19.425000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "The runbook is nice to have, but the requirements is fine for now.",
      "start_time": "2026-09-15T14:06:19.427000Z",
      "end_time": "2026-09-15T14:06:23.760000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "A few managers mentioned the API versioning earlier,",
      "start_time": "2026-09-15T14:06:25.177000Z",
      "end_time": "2026-09-15T14:06:27.843000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Dev Iyer"
      },
      "text": "Okay, that works.",
