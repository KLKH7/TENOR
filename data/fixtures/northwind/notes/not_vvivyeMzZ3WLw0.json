      "end_time": "2026-09-10T16:09:19.205000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Like, it's like,",
      "start_time": "2026-09-10T16:09:19.221000Z",
      "end_time": "2026-09-10T16:09:20.221000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "the edge cases is low risk and nobody wants to say it.",
