      "end_time": "2026-09-10T16:06:09.295000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Yeah, yeah.",
      "start_time": "2026-09-10T16:05:58.459000Z",
      "end_time": "2026-09-10T16:05:59.059000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Alex Rivera"
      },
      "text": "Right.",
