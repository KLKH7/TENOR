    {
      "speaker": {
        "source": "speaker",
        "name": "Dev Iyer"
      },
      "text": "I mean.",
      "start_time": "2026-10-13T14:07:38.880000Z",
      "end_time": "2026-10-13T14:07:39.547000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Dev Iyer"
      },
      "text": "Okay, I'm more positive about the deploy freeze",
