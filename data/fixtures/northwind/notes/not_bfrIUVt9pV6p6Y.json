      "end_time": "2026-10-13T14:04:17.725000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Dev Iyer"
      },
      "text": "the priority list is overdue for a cleanup, or whatever.",
      "start_time": "2026-10-13T14:04:20.519000Z",
      "end_time": "2026-10-13T14:04:23.852000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Um",
      "start_time": "2026-10-13T14:04:23.864000Z",
      "end_time": "2026-10-13T14:04:24.464000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Funny enough, it's less about the error budget and more about the database indexes, honestly.",
