    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Yusuf Demir"
      },
      "text": "Oh, interesting.",
      "start_time": "2026-10-13T14:03:57.180000Z",
      "end_time": "2026-10-13T14:03:57.847000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Okay.",
