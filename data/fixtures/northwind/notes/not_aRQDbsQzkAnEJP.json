      "start_time": "2026-10-06T15:06:13.659000Z",
      "end_time": "2026-10-06T15:06:14.992000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "So.",
      "start_time": "2026-10-06T15:06:15.071000Z",
      "end_time": "2026-10-06T15:06:15.671000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "I feel like the follow ups mostly cosmetic.",
      "start_time": "2026-10-06T15:06:15.749000Z",
      "end_time": "2026-10-06T15:06:18.415000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Elena Petrova"
      },
      "text": "Right, so if we revisit it next cycle, then the like usability sessions gets a lot easier.",
