      "end_time": "2026-10-06T15:06:49.929000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Ruth Abebe"
      },
      "text": "Also",
      "start_time": "2026-10-06T15:06:49.993000Z",
      "end_time": "2026-10-06T15:06:50.593000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Ruth Abebe"
      },
      "text": "I keep coming back to the follow ups.",
