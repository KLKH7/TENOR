      "end_time": "2026-09-21T09:06:37.175000Z"
    },
    {
      "speaker": {
        "source": "speaker"
      },
      "text": "It was down earlier.",
      "start_time": "2026-09-21T09:06:37.446000Z",
      "end_time": "2026-09-21T09:06:38.984000Z"
    },
