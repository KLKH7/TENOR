      "end_time": "2026-09-21T09:06:59.293000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Yeah, that makes sense to me.",
      "start_time": "2026-09-21T09:06:59.648000Z",
      "end_time": "2026-09-21T09:07:01.956000Z"
    },
    {
      "speaker": {
        "source": "speaker"
      },
      "text": "like, Alex, what's like, on your plate?",
