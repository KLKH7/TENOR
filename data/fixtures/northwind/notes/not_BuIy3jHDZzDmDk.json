      "end_time": "2026-09-21T09:07:17.441000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Tomás Herrera"
      },
      "text": "So.",
      "start_time": "2026-09-21T09:07:17.660000Z",
