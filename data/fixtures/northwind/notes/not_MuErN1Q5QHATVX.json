      "end_time": "2026-09-09T15:14:01.475000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Which",
      "start_time": "2026-09-09T15:14:01.499000Z",
      "end_time": "2026-09-09T15:14:02.099000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "we said we'd timebox it and then the tooltip pattern happened",
      "start_time": "2026-09-09T15:14:06.177000Z",
      "end_time": "2026-09-09T15:14:09.844000Z"
    },
    {
      "speaker": {
        "source": "speaker"
      },
      "text": "Right",
      "start_time": "2026-09-09T15:14:19.601000Z",
      "end_time": "2026-09-09T15:14:20.201000Z"
    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Megan Liu"
      },
      "text": "Yeah, there's a world where we look at it with fresh eyes and the like table density just goes away.",
