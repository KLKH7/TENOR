      "end_time": "2026-08-31T09:00:40.106000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "I was saying I agree.",
      "start_time": "2026-08-31T09:00:40.963000Z",
      "end_time": "2026-08-31T09:00:42.887000Z"
    },
    {
      "speaker": {
        "source": "microphone"
      },
      "text": "Let's not go down that rabbit hole right now.",
