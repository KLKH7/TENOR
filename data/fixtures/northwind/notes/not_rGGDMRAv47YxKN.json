    },
    {
      "speaker": {
        "source": "speaker",
        "name": "Inês Duarte"
      },
      "text": "Sorry, what's the plan for the service boundaries? From my side, a few managers keep asking about the alerting thresholds.",
      "start_time": "2026-10-05T09:08:56.311000Z",
